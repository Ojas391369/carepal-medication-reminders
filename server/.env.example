# Copy to server/.env (never commit the real file)
PORT=4000
APP_TZ=Asia/Kolkata

# Demo access codes (change them for anything beyond a demo)
CAREGIVER_CODE=nurse123
FAMILY_CODE=family123
# When true, the login screen shows the demo codes above
DEMO_MODE=true

# Web push (VAPID). Leave empty and keys are generated into server/data/vapid.json on first run.
# Generate your own with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional email reminders (SMTP). Without these, emails are logged to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TheCarePal Reminders <no-reply@example.com>
